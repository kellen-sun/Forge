- 1 1 1 1 1 1
op_1_const 1 1 1 1 1 1
op_2_add 3 1 1 3 1 1
---
#include <metal_stdlib>
using namespace metal;
kernel void op_1_const(device float* Out [[buffer(0)]],uint gid [[thread_position_in_grid]]){Out[gid]=1.500000000e+00f;}
kernel void op_2_add(device float* Out [[buffer(0)]],const device float* A [[buffer(1)]],const device float* B [[buffer(2)]],uint gid [[thread_position_in_grid]]){long idx_a=0;{uint remaining=gid;{uint c=remaining%3u;idx_a+=long(c)*1L;remaining/=3u;}}long idx_b=0;{uint remaining=gid;{uint c=remaining%3u;idx_b+=long(c)*0L;remaining/=3u;}}Out[gid]=A[idx_a]+B[idx_b];}
